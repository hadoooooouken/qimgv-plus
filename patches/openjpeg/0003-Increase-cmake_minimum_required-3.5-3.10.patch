From a70b8f136e86fac2e63b8922d157b5446fc34adb Mon Sep 17 00:00:00 2001
From: Thomas Bracht Laumann Jespersen <t@laumann.xyz>
Date: Fri, 5 Dec 2025 13:33:12 +0100
Subject: [PATCH 03/15] Increase cmake_minimum_required 3.5 -> 3.10

Closes: https://github.com/uclouvain/openjpeg/issues/1606
Signed-off-by: Thomas Bracht Laumann Jespersen <t@laumann.xyz>
---
 CMakeLists.txt                     |  2 +-
 tests/nonregression/CMakeLists.txt | 10 +++++-----
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5c5f4e5c..e4c5d006 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -7,7 +7,7 @@
 # For this purpose you can define a CMake var: OPENJPEG_NAMESPACE to whatever you like
 # e.g.:
 # set(OPENJPEG_NAMESPACE "GDCMOPENJPEG")
-cmake_minimum_required(VERSION 3.5...3.31.5)
+cmake_minimum_required(VERSION 3.10...3.31.5)
 
 if(NOT OPENJPEG_NAMESPACE)
   set(OPENJPEG_NAMESPACE "OPENJPEG")
diff --git a/tests/nonregression/CMakeLists.txt b/tests/nonregression/CMakeLists.txt
index fe9f43cf..050b77e6 100644
--- a/tests/nonregression/CMakeLists.txt
+++ b/tests/nonregression/CMakeLists.txt
@@ -1,6 +1,6 @@
 # NON-REGRESSION TESTS ON THIS DATASET LOCATED ${OPJ_DATA_ROOT}/input/nonregression
 
-cmake_minimum_required(VERSION 3.5)
+cmake_minimum_required(VERSION 3.10)
 
 file(MAKE_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/Temporary)
 
@@ -61,7 +61,7 @@ set(BLACKLIST_JPEG2000
     broken3.jp2
     broken4.jp2
     edf_c2_20.jp2 #may look ok as per kdu_jp2info, but inspection it reveals that the transformation value is out of range
-    gdal_fuzzer_assert_in_opj_j2k_read_SQcd_SQcc.patch.jp2	
+    gdal_fuzzer_assert_in_opj_j2k_read_SQcd_SQcc.patch.jp2
     gdal_fuzzer_check_comp_dx_dy.jp2
     gdal_fuzzer_check_number_of_tiles.jp2
     gdal_fuzzer_unchecked_numresolutions.jp2
@@ -122,7 +122,7 @@ foreach(INPUT_FILENAME ${OPJ_DATA_NR_LIST})
                          PROPERTIES WILL_FAIL TRUE)
 
   else()
-  	
+
     # Compare the dump output with the baseline
     add_test(NAME NR-${INPUT_FILENAME_NAME}-compare_dump2base
   	        COMMAND compare_dump_files
@@ -418,7 +418,7 @@ foreach(OPJ_TEST_CMD_LINE ${OPJ_TEST_CMD_LINE_LIST})
               set_tests_properties(NR-ENC-${INPUT_FILENAME_NAME}-${IT_TEST_ENC}-jpylyser PROPERTIES
                 DEPENDS NR-ENC-${INPUT_FILENAME_NAME}-${IT_TEST_ENC}-encode
                 PASS_REGULAR_EXPRESSION "<isValidJP2>True</isValidJP2>"
-                )		
+                )
             endif()
           endif(JPYLYZER_EXECUTABLE)
 
@@ -438,7 +438,7 @@ foreach(OPJ_TEST_CMD_LINE ${OPJ_TEST_CMD_LINE_LIST})
                 )
               set_tests_properties(NR-ENC-${INPUT_FILENAME_NAME}-${IT_TEST_ENC}-lossless-compare PROPERTIES
                 DEPENDS NR-ENC-${INPUT_FILENAME_NAME}-${IT_TEST_ENC}-lossless-decode
-                )	
+                )
             endif()
           endif()
       endif()
-- 
