-{
-    opj_mqc_renorme_macro(mqc, mqc->a, mqc->c, mqc->ct);
-}
-
 /**
 Encode the most probable symbol
 @param mqc MQC handle
@@ -521,4 +516,4 @@ void opj_mqc_byteout(opj_mqc_t *mqc)
             }
         }
     }
-}
\ No newline at end of file
+}
